//--- Minimum Gauge Rail (381 mm to 508mm)
//	"mA_N", "mAAN", "mABN", "mACN", "mADN", "mAdN", "mAEN",// "mAFN",
//	"mK_N", "mKAN", "mKBN", "mKCN", "mKDN", "mKdN", "mKEN",// "mKFN",
