//	"mN_N", "mNAN", "mNBN", "mNCN", "mNDN", "mNdN", "mNEN",// "mNFN",
//	"mE_N", "mEAN", "mEBN", "mECN", "mEDN", "mEdN", "mEEN",// "mEFN",
//	"mO_N", "mOAN", "mOBN", "mOCN", "mODN", "mOdN", "mOEN",// "mOFN",
//	"mF_N", "mFAN", "mFBN", "mFCN", "mFDN", "mFdN", "mFEN",// "mFFN",
//	"mP_N", "mPAN", "mPBN", "mPCN", "mPDN", "mPdN", "mPEN",// "mPFN",
//	"mG_N", "mGAN", "mGBN", "mGCN", "mGDN", "mGdN", "mGEN",// "mGFN",
//	"mQ_N", "mQAN", "mQBN", "mQCN", "mQDN", "mQdN", "mQEN",// "mQFN",
//	"mH_N", "mHAN", "mHBN", "mHCN", "mHDN", "mHdN", "mHEN",// "mHFN",
//	"mR_N", "mRAN", "mRBN", "mRCN", "mRDN", "mRdN", "mREN",// "mRFN",
//	"mS_N", "mSAN", "mSBN", "mSCN", "mSDN", "mSdN", "mSEN",// "mSFN",
//	"ms_N", "msAN", "msBN", "msCN", "msDN", "msdN", "msEN",// "msFN",
