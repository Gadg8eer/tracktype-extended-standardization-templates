/* ----------- */
// COINs are a fictional currency based on the price of bread in the US in 2000-2001 ($1.00 USD), with all other costs informed by the amount of energy in loaves of bread required to build something. This is gameplay balanced.
// c is 5 mph, or ~10 km/h; 1594, wooden wagonways - 6.62 COINs/tile
// b is 10 mph, or ~15 km/h; 1594, plateways - 6.62 COINs/tile
// a is 10 mph, or ~15 km/h; 1799, prototype rails - 6.62 COINs/tile
// A is 15 mph, or ~25 km/h; 1800, shunting yard - 6.62 COINs/tile
// B is 30 mph, or ~50 km/h; 1825, branch line - 10 COINs/tile
// C is 95 mph, or ~155 km/h; 1890, bulk mineral transport - 25 COINs/tile
// D is 105 mph, or ~170 km/h; 1904-05-04, main line - 30 COINs/tile
// E is 125 mph, or ~200 km/h; 1930-01-01, express rail transport - 40 COINs/tile
// F is 200 mph, or ~320 km/h; 1958-12-31, high speed line - 55 COINs/tile
// G is 220 mph, or ~355 km/h; 2008-04-11, dedicated high speed line - 60 COINs/tile
// H is unlimited; 2030-01-01, dedicated express high speed line - 70 COINs/tile
/* ----------- */
// Amps are a currency based on the price of bread in the US in 2000-2001 ($1.00 USD), with all other costs pegged to the value of the amount of energy in loaves of bread required to build something.
// c is 5 mph, or ~10 km/h; 1594, wooden wagonways - 6.62 COINs/tile
// b is 10 mph, or ~15 km/h; 1594, plateways - 6.62 COINs/tile
// a is 10 mph, or ~15 km/h; 1799, prototype rails - 6.62 COINs/tile
// A is 15 mph, or ~25 km/h; 1800, shunting yard - 6.62 COINs/tile
// B is 30 mph, or ~50 km/h; 1825, branch line - 10 COINs/tile
// C is 95 mph, or ~155 km/h; 1890, bulk mineral transport - 25 COINs/tile
// D is 105 mph, or ~170 km/h; 1904-05-04, main line - 30 COINs/tile
// E is 125 mph, or ~200 km/h; 1930-01-01, express rail transport - 40 COINs/tile
// F is 200 mph, or ~320 km/h; 1958-12-31, high speed line - 55 COINs/tile
// G is 220 mph, or ~355 km/h; 2008-04-11, dedicated high speed line - 60 COINs/tile
// H is unlimited; 2030-01-01, dedicated express high speed line - 70 COINs/tile
/* ----------- */
 // Third letter is axle load; The following is only a set of guidelines, not a prescribed value for axle weight classes, you may deviate from it at will :)
 // SAcN [WWAY] (Wooden) is maximum is maximum 1 metric tonne/megagram, 1.102311 short tons, 1000 kg; available in 1594, only horses
 // SAbN [LTRL] (Plateway) is maximum 1 metric tonne/megagram, 1.102311 short tons, 1000 kg; available in 1799, horses and prototype steam locos
 // SAaN (Prototype Rails) is maximum 1 metric tonne/megagram, 1.102311 short tons, 1000 kg; available in 1820, prototype steam locos
 // SAAN is maximum 10 metric tonnes/megagrams, 11.02311 short tons, 10000 kg; available in 1828, prototype and standard gauge locos
 // SABN [RAIL] (Rail) is maximum 20 metric tonnes/megagrams, 22.04623 short tons, 20000 kg; available in 1968, meant to also be a tramtype if the two systems are ever unified
 // SA_N would be maximum 30 metric tonnes/megagrams, 33.06934 short tons, 30000 kg; available around 1978, not based on any real rail axle load class
 // SACN is maximum 40 metric tonnes/megagrams, 44.09245 short tons, 40000 kg per axle; available in 1988
 // SADN is maximum 45 metric tonnes/megagrams, 44.09245 short tons, 40000 kg per axle; first available in 2008 but only for unpowered rolling stock, as the axle load of SADN is normally 40 megagrams, but by making the trucks on the cars lighter at least 50 Mg is apparently attainable in 2023
 // SAdN is maximum 50 metric tonnes/megagrams, 55.11557 short tons, 50000 kg per axle; first available in 2008 but only for unpowered rolling stock, as the axle load of SADN is normally 40 megagrams, but by making the trucks on the cars lighter at least 50 Mg is apparently attainable in 2023
 // SAEN is maximum 60 metric tonnes/megagrams or more (unlimited) axle load for future-proofing; available in 2028

/*
 * *********************
 * Define railtype table
 * *********************
 */

basecost {
    PR_BUILD_RAIL: 8; // normal rail at x256
}

// For custom railtypes WWAY and LTRL
railtypetable {
//    "WWAY": { base_cost: 0; }   // No multiplier for WWAY
//    "WGWY": { base_cost: 0; }   // No multiplier for WGWY
    "WAcN": { base_cost: 0; }   // No multiplier for WAcN
//    "LTRL": { base_cost: 0; }   // No multiplier for LTRL
//    "LIHT": { base_cost: 0; }   // No multiplier for LIHT
    "WAbN": { base_cost: 0; }   // No multiplier for WAbN
//    "RAIL": { base_cost: 8; }   // Default multiplier for SAaN
    "SAaN": { base_cost: 10; }   // No multiplier for SAaN
//--- Cheat rail ()
	//"_R_c",
//--- Tunnels
	"_s_t", // Grass tunnel (Low Clearance, no doube-decker railcars)
	"_S_t", // Grass tunnel (Universal)
	//"_Sgt", // Grass tunnel (no rack)
	"_t_t", // CHIPS dirt tunnel (Universal)
	"_v_t", // CHIPS cobblestone tunnel (Universal)
	"_i_t", // CHIPS pavement tunnel (Universal)
	"_U_t", // Urban concrete tunnel (Universal)
	"_z_t", // North Korean concrete tunnel (Universal)
	"_Z_t", // South Korean concrete tunnel (Universal)
	"_I_t", // ISR concrete tunnel (Universal)
	"_J_t", // JP+ Urban concrete
	"_Y_t", // Airport concrete tunnel (Universal)
	"_y_t", // Light grey concrete tunnel (Universal)
	
//--- Eyecandy
	"0S--", // Vanilla grass fill
	"0t--", // CHIPS dirt fill
	"0v--", // CHIPS cobblestone fill
	"0i--", // CHIPS pavement fill
	"0z--", // North Korean concrete fill
	"0U--", // Urban concrete fill
	"0Z--", // South Korean concrete fill
	"0I--", // ISR pavement fill
	"0J--", // JP+ Urban fill
	
