	//[left_x,	upper_y,	width,		height,	 offset_x,		offset_y]
	[60,		y,			8,		 25,			-3, -17 ]
	[76,		y,			22,		22,			-10, -15 ]
	[107,		 y,			32,		15,			-8, -11 ]
	[156,		 y,			22,		22,			-4, -13 ]
	[188,		 y,			8,		 25,			-3, -10 ]
	[204,		 y,			22,		22,			-17, -12 ]
	[235,		 y,			32,		15,			-24 + adjust_xoffs, -11 ]
	[284,		 y,			22,		22,			-10, -16 ]
}

