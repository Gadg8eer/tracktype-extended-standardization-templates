					1: string(STR_PARAM_3RD_1);
					2: string(STR_PARAM_3RD_2);
					3: string(STR_PARAM_3RD_3);
					4: string(STR_PARAM_3RD_4);
					5: string(STR_PARAM_3RD_5);
			};
		}
	}
	param 4 {
		param_fences {
			type: int;
			name: string(STR_PARAM_FENCES_NAME);
