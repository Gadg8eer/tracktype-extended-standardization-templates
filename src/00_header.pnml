	param 5 {
		param_tunnel {
			type: bool;
			name: string(STR_PARAM_TUNNEL_NAME);
			desc: string(STR_PARAM_TUNNEL_DESC);
			def_value: 0;
		}
	}
	param 6 {
		param_earlyrail {
			type: int;
			min_value: 0;
			max_value: 4;
			def_value: 0;
			name:   string(STR_PARAM_NAME_EARLY_RAIL);
            desc:   string(STR_PARAM_DESC_EARLY_RAIL);
            names: {
                        0: string(STR_PARAM_EARLY_RAIL_AUTO);
