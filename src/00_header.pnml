// Add this to your language/strings file, or as fallback here:
//
//    string(STR_AMPWORKS_NAME,   "AmpWorks")
//    string(STR_AMPWORKS_SYMBOL, "₳")

	if (param_realism == 1) {
		basecost {
		// All prices should be based on the price of a loaf of bread in American Dollars in the year 2000 ($1.00 USD) converted into 2 million scientific calories (2000 food calories/kilocalories).
		// £1.00 GBP was worth 3300 food calories, or ~₳15,979 milliAmp•hours (mA•h), in 2000. One USD was less than one GBP and OpenTTD uses GBP as the base currency, so adjustment for inflation followed by conversion from Y2K!USD to into Y2K!GBP is necessary.
		// Unfortunately, the USD in OpenTTD is NOT equal to whatever exchange rate, but is a flat "$2 = £1" at all times.
		// The rate in 2000 from USD to GBP was $1.00 USD = £0.70 GBP at it's peak for the year, and then from that you convert the GBP to purchasing power (how much bread and similar staples cost) and convert purchasing power into food calories; £0.01 GBP in 2000 was equal to $0.02 USD, but only due to rounding up, and the purchasing power of GBP in 2000 was 33 food calories, or 15.979 mA•h (milliAmpWorks), per pence. One Mill (1/10 of a pence, or "£0.001" with three decimal places) was not used in 2000 by the UK, but would have been equal to just under 1.6 mA•h. Prices should be adjusted for inflation and exchange rates accordingly.
		// The rest is included in the readme.
		
		// Ignore the above for electric locomotives and track! Instead, assume fuel costs for non-electric vehicles are measured in kiloAmp-Hours via statistics available online like horsepower or fuel economy.
			// Unchanged unless noted otherwise.
			PR_STATION_VALUE: 0; // 0.042 per tile owned
			PR_BUILD_RAIL: 0; //  21.336 metres of track
			PR_BUILD_SIGNALS: 0; // A unit of £0.65 GBP, worth ~₳10 AmpWorks, or ~₳10,387 mA•h for one signal
			PR_BUILD_BRIDGE: 0; // A unit of £2.75 GBP, worth ~₳44 AmpWorks, or ~₳43,946 mA•h for 21.336 metres of length (minimum 42.627 meters)
			PR_BUILD_DEPOT_TRAIN: 0; // A unit of £6.00 GBP, worth ~₳96 AmpWorks, or ~₳95,883 mA•h
			PR_BUILD_TUNNEL: 0; // A unit of £4.50 GBP, worth ~₳72 AmpWorks, or ~₳71,913 mA•h
			PR_BUILD_STATION_RAIL: 0; // A unit of £2.00 GBP, worth ~₳32 AmpWorks, or ~₳31.958 mA•h for one tile
			PR_BUILD_STATION_RAIL_LENGTH: 0; // A unit of £1.80 GBP, worth ~₳29 AmpWorks, or ~₳28,763 mA•h 21.336 metres of track
			PR_CLEAR_RAIL: 0; // A unit of £0.70 GBP (or rather, "-£0.70"; a refund!), worth ~₳11 AmpWorks, or ~11,183 mA•h
			PR_CLEAR_SIGNALS: 0; // A unit of £0.10 GBP, worth ~₳2 AmpWorks, or ~₳1,597 mA•h
			PR_CLEAR_BRIDGE: 0; // A unit of £0.50 GBP, worth ~₳8 AmpWorks, or ~₳7,9895 mA•h for a bridge with only end pieces
			PR_CLEAR_DEPOT_TRAIN: 0; // A unit of £0.80 GBP, worth ~₳13 AmpWorks, or ~₳12,783 mA•h
			PR_CLEAR_TUNNEL: 0; // A unit of £0.30 GBP, worth ~₳5 AmpWorks, or ~₳4,794 mA•h
			PR_CLEAR_STATION_RAIL: 0; // A unit of £0.50 GBP, worth ~₳8 AmpWorks, or ~₳7,9895 mA•h
			PR_BUILD_WAYPOINT_RAIL: 0; // A unit of £6.00 GBP, worth ~₳96 AmpWorks, or ~₳95,874 mA•h
			PR_CLEAR_WAYPOINT_RAIL: 0; // A unit of £0.80 GBP, worth ~₳13 AmpWorks, or ~₳12,783 mA•h
			PR_BUILD_FOUNDATION: 0; // A unit of £2.50 GBP, worth ~₳40 AmpWorks, or ₳39,947 mA•h
			PR_MAINTENANCE_RAIL: 0; // A unit of £0.10 GBP p/year (£0.01 per month), worth ~₳2 AmpWorks, or ₳1,917 mA•h
									// NOTE: Always have "maintenance_cost" set to "<your intended per-year cost> / 12".
									// NOTE: Maintenance is charged p/tile each month in wallclock mode, but only yearly in calendar mode. Always use wallclock mode with realism mode. 
			PR_MAINTENANCE_STATION: 0; // A unit of £1.00 GBP, worth ~$1.65 to ~$1.80 USD, ~₳16 AmpWorks, or ₳15,979 mA•h each.
		}
	}
 
