    param 0 {
        param_gui {
            type:   int;
            name:   string(str_param_gui_name);
            desc:   string(str_param_gui_desc);
            min_value:  0;
            max_value:  1;
            def_value:  0;
            names:  {
                    0: string(str_param_opengfx);
                    1: string(str_param_ttd);
                    };
        }
    }
	param 1 { // 23 in U&RaTT Patch (Assume for Long Haul server that parameter is either 3 or 4)
		param_axle_weight {
		type: int;
		name: string(STR_PARAM_AXLE_WEIGHT_NAME);
		desc: string(STR_PARAM_AXLE_WEIGHT_DESC);
		min_value: 0;
		max_value: 4;
		def_value: 0;
			names: {
				0: string(STR_PARAM_AXLE_WEIGHT_NONE);
				1: string(STR_PARAM_AXLE_WEIGHT_STANDARD_2012);
				2: string(STR_PARAM_AXLE_WEIGHT_CONVENTION_2022);
				3: string(STR_PARAM_AXLE_WEIGHT_OUTATIME_202X);
				4: string(STR_PARAM_AXLE_WEIGHT_UPDATE_2024);
				5: string(STR_ERROR_AXLE_WEIGHT_TRIGGER_ERROR);
			};
		}
	}
	param 2 { // 24 in U&RaTT Patch (Assume 1 for Long Haul server, 0 for legacy/simple mode
		param_realism {
		type: int;
		name: string(STR_PARAM_FORCE_REALISM_NAME);
		desc: string(STR_PARAM_FORCE_REALISM_DESC);
		min_value: 0;
		max_value: 1;
		def_value: 0;
			names: {
