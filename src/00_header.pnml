template spriteset_template_double_juice(y, adjust_xoffs) {
	//[left_x,	upper_y,	width,		height,	 offset_x,		offset_y]
	[60,		y,			8,		 25,			-3, -17 ]
	[76,		y,			22,		22,			-10, -15 ]
	[107,		 y,			32,		15,			-8, -11 ]
	[156,		 y,			22,		22,			-4, -13 ]
	[188,		 y,			8,		 25,			-3, -10 ]
	[204,		 y,			22,		22,			-17, -12 ]
	[235,		 y,			32,		15,			-24 + adjust_xoffs, -11 ]
	[284,		 y,			22,		22,			-10, -16 ]
}

template spriteset_template_purchase_double_juice() {
	//[left_x,	upper_y,	width,		height,	 offset_x,		offset_y]
	[60,	10, 1, 1, 0, 0]
	[60,	10, 1, 1, 0, 0]
	[107,	 10, 1, 1, 0, 0]
	[60,	10, 1, 1, 0, 0]
	[60,	10, 1, 1, 0, 0]
	[60,	10, 1, 1, 0, 0]
	[316,	 10, 32, 15, -16, -10 ]
	[60,	10, 1, 1, 0, 0]
}

template template_electrostar(x,y){
	//left_x, upper_y, width, height, offset_x, offset_y
	[ x, y, 8, 24, -3, -8]
	[ x+9, y, 22, 19, -14, -11]
	[ x+32, y, 32, 15, -16, -11]
	[ x+65, y, 22, 19, -6, -11]
	[ x+88, y, 8, 24, -3, -8]
	[ x+97, y, 22, 19, -16, -11]
	[ x+120, y, 32, 15, -16, -11]
	[ x+153, y, 22, 19, -7, -11]
}

template tmpl_vehicle_1_views_purchase_acs(x,y){
	[ x, y, 41, 13, -20, -8]
}


