
	if (param_axle_weight == 0 && param_realism == 0) {
		if (param_earlyrail == 0 && ((railtype_available("WWAY") || railtype_available("WGWY")) && loading_stage == LOADING_STAGE_RESERVE) || (param_earlyrail == 2 || param_earlyrail == 4)) {
			//-- Standard Gauge, Wagonway Tracks
			// "WWAY"
			// "SAcN"
			item(FEAT_RAILTYPES, railtype_custom_infinite_1metrictonne_selfpower) {
				property {
					label:							"WAcN";
					name:							string(STR_RAILTYPE_NAME_WWAY_2004);
					station_graphics:				RAILTYPE_STATION_NORMAL;
					sort_order:						0;
				//---
				//	railtype_flags:					bitmask(RAILTYPE_FLAG_HIDDEN);
					acceleration_model:				ACC_MODEL_RAIL;
				}
			}
		}
	}

 /* REALISM MODE VERSION */
 // See the included notes for more info. This is an EXPERIMENTAL parameter for now.

	if (param_axle_weight == 0 && param_realism == 1) {
		if ((param_earlyrail == 0 && ((railtype_available("WWAY") || railtype_available("WGWY")) && loading_stage == LOADING_STAGE_RESERVE)) || (param_earlyrail == 2 || param_earlyrail == 4)) {
			//-- Wooden Wagonway
			// "WWAY"
			// "SAcN"
			item(FEAT_RAILTYPES, railtype_earlyrail_xlow_1metrictonne_selfpower) {
				property {
					label:							"WbcN";
					introduction_date:				1594/01/01;
					name:							string(STR_RAILTYPE_NAME_WWAY_2004);
					//toolbar_caption:				string(STR_RAILTYPE_NAME_WWAY_2004);
					station_graphics:				RAILTYPE_STATION_NORMAL;
					sort_order:						0;
				//---
					railtype_flags:					bitmask(RAILTYPE_FLAG_DISALLOW_90DEG);
					speed_limit:					12 km/h; // SAcN - One tile per 6.41 irl seconds
					acceleration_model:				ACC_MODEL_RAIL;
					curve_speed_multiplier:			0.125; // Very low speeds
				// ₳48,006 Amp¤Works per 21.336 metres for wagonway
				// +0% for building electrification = ₳0
					construction_cost:				2508 / 60; // In units of ~₳50 Amp¤Works per section of 10.668 metres (1/2 tile) to 21.336 metres (1 tile)
				// ₳6,408 Amp¤Works/year in-game per 0.5-1.0 tiles (exactly 112.644 feet for reference) per 1440 minutes
				// DOESN'T HAVE ELECTRIFICATION!
				// ~₳0 Amp¤Works to power electrification
				// TOTAL: ~₳534 Amp¤Works
					maintenance_cost:				372 / 12; // In units of ~₳50 Amp¤Works per tile per irl day
			}
		}
	}

	if (param_revenge == 1) {
		item(FEAT_RAILTYPES, railtype_earlyrail_wagonway_1metrictonne_selfpower) {
			
		}
	}