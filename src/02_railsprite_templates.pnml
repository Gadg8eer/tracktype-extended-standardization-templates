	tmpl_overlay_type()
}

spriteset(normal_THFI_precombined, "gfx/rails/MGLV/THFI/THFI.png") {											// PRECOMBINED
	tmpl_precombined_type()
}
spriteset(snow_THFI_precombined, "gfx/rails/MGLV/THFI/THFI_snow.png") {
	tmpl_precombined_type()
}
switch(FEAT_RAILTYPES, SELF, switch_THFI_precombined, terrain_type) {
	TILETYPE_SNOW: snow_THFI_precombined;
	normal_THFI_precombined;
}

spriteset(normal_THFI_underlay, "gfx/rails/MGLV/THFI/THFI.png") {												// UNDERLAY
	tmpl_underlay_type(0)
}
spriteset(snow_THFI_underlay, "gfx/rails/MGLV/THFI/THFI.png") {
	tmpl_underlay_type(80)
}
switch(FEAT_RAILTYPES, SELF, switch_THFI_underlay, terrain_type) {
	TILETYPE_SNOW: snow_THFI_underlay;
	normal_THFI_underlay;
}

spriteset(normal_THFI_bridge, "gfx/rails/MGLV/THFI/THFI.png") {													// BRIDGE
	tmpl_bridge_surfaces(0)
}
spriteset(snow_THFI_bridge, "gfx/rails/MGLV/THFI/THFI.png") {
	tmpl_bridge_surfaces(414)
}
switch(FEAT_RAILTYPES, SELF, switch_THFI_bridge, terrain_type) {
	TILETYPE_SNOW: snow_THFI_bridge;
	normal_THFI_bridge;
}
spriteset(switch_THFI_U_bridge, "gfx/rails/MGLV/THFI/THFI_snow.png") {												// U_BRIDGE
	tmpl_bridge_surfaces(0)
}

spriteset(normal_THFI_tunnel_overlay, "gfx/rails/MGLV/THFI/THFI.png") {											// TUNNEL_OVERLAY
	tmpl_tunnel_overlay_type(0)
}
spriteset(snow_THFI_tunnel_overlay, "gfx/rails/MGLV/THFI/THFI.png") {
	tmpl_tunnel_overlay_type(276)
}
switch(FEAT_RAILTYPES, SELF, switch_THFI_tunnel_overlay, terrain_type) {
	TILETYPE_SNOW: snow_THFI_tunnel_overlay;
	normal_THFI_tunnel_overlay;
}

spriteset(normal_THFI_tunnel_1, "gfx/rails/MGLV/THFI/THFI.png") {													// TUNNEL
	tmpl_tunnel_type(0)
}
spriteset(snow_THFI_tunnel_1, "gfx/rails/MGLV/THFI/THFI.png") {
	tmpl_tunnel_type(276)
}
spriteset(normal_THFI_tunnel_0, "gfx/rails/MGLV/THFI/THFI_snow.png") {													// TUNNEL
	tmpl_tunnel_type(0)
}
spriteset(snow_THFI_tunnel_0, "gfx/rails/MGLV/THFI/THFI_snow.png") {
	tmpl_tunnel_type(276)
}
switch(FEAT_RAILTYPES, SELF, switch_THFI_tunnel_1, terrain_type) {
	TILETYPE_SNOW: snow_THFI_tunnel_1;
	normal_THFI_tunnel_1;
}
switch(FEAT_RAILTYPES, SELF, switch_THFI_tunnel_0, terrain_type) {
	TILETYPE_SNOW: snow_THFI_tunnel_0;
	normal_THFI_tunnel_0;
}
switch(FEAT_RAILTYPES, SELF, switch_THFI_tunnel, param_tunnel) {
	1: switch_THFI_tunnel_1;
	switch_THFI_tunnel_0;
}

spriteset(normal_THFI_depots, "gfx/rails/MGLV/THFI/THFI.png") {														//DEPOTS
	rail_depot_template_gadg8eer(0)
}
spriteset(snow_THFI_depots, "gfx/rails/MGLV/THFI/THFI.png") {
	rail_depot_template_gadg8eer(414)
}
switch(FEAT_RAILTYPES, SELF, switch_THFI_depots, terrain_type) {
	TILETYPE_SNOW: snow_THFI_depots;
	normal_THFI_depots;
}

spriteset(fences_THFI, "gfx/rails/MGLV/THFI/THFI.png") {
	tmpl_fences(0)
}
spriteset(fences_THFI_cc, "gfx/rails/MGLV/THFI/THFI.png") {
	tmpl_fences(43)
}
switch(FEAT_RAILTYPES, SELF, switch_THFI_fences, param_fences) {
	0: fences_empty;
	2: fences_THFI;
	3: fences_THFI;
	4: fences_THFI_cc;
}

spriteset(gui_THFI_UGUI, "gfx/rails/MGLV/THFI/THFI.png") {															//GUI						
	tmpl_gui_UGUI()
}
spriteset(gui_THFI_opengfx, "gfx/rails/MGLV/THFI/THFI.png") {														//GUI
	tmpl_gui_gfx()
}
spriteset(gui_THFI_ttd, "gfx/rails/MGLV/THFI/THFI.png") {
	tmpl_gui_ttd()
}
switch (FEAT_RAILTYPES, SELF, switch_THFI_gui, param_gui) {
	1: gui_THFI_opengfx;
	2: gui_THFI_UGUI;
	gui_THFI_ttd;
}
